{
  "name": "@floriandrevet/ng-template",
  "version": "22.0.0",
  "description": "Configurable Angular 22 project generator (Angular Schematics): SSR, authentication (Microsoft Entra ID / generic OIDC), i18n, UI library, Docker and CI, all opt-in.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlorianDrevet/angular_template.git"
  },
  "keywords": [
    "angular",
    "schematics",
    "ng-new",
    "template",
    "generator",
    "scaffolding"
  ],
  "main": "dist/index.js",
  "schematics": "./dist/collection.json",
  "ng-update": {
    "migrations": "./dist/migrations.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.8",
    "@angular-devkit/schematics": "22.1.8",
    "@angular/cli": "22.1.8",
    "@eslint/js": "^9.38.0",
    "@schematics/angular": "22.1.8",
    "@types/node": "^24.13.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.{ts,json,md}": [
      "prettier --write"
    ]
  }
}
